<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Aurora base -->
    <View
        android:id="@+id/vAuroraBg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#FFF0EEFF" />

    <!-- Aurora blob view — added programmatically -->
    <FrameLayout
        android:id="@+id/flAuroraContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!--
        Main content: satu LinearLayout vertikal terpusat di layar.
        FrameLayout gravity="center" = selalu tengah, no scroll, no chain.
    -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_gravity="center_horizontal"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingStart="32dp"
        android:paddingEnd="32dp"
        android:paddingTop="0dp"
        android:paddingBottom="0dp">

        <!-- Status Pill -->
        <LinearLayout
            android:id="@+id/llStatusPill"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_status_pill_offline"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="14dp"
            android:paddingEnd="16dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:elevation="2dp">

            <View
                android:id="@+id/vStatusLed"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:layout_marginEnd="7dp"
                android:background="@drawable/led_dot_offline"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tvStatusCode"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.05"
                android:text="OFFLINE"
                android:textColor="@color/status_offline_text"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Pairing Code badge -->
        <TextView
            android:id="@+id/tvPairingCode"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_pairing_code_display"
            android:elevation="4dp"
            android:fontFamily="monospace"
            android:letterSpacing="0.12"
            android:paddingStart="28dp"
            android:paddingEnd="28dp"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            android:text="---"
            android:textColor="@color/pairing_code_text"
            android:textSize="28sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <!-- Status message -->
        <TextView
            android:id="@+id/tvStatusMessage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:maxLines="2"
            android:text="Tidak dapat terhubung."
            android:textColor="#10050655"
            android:textSize="14sp"
            android:textStyle="bold" />

        <!-- Action buttons -->
        <LinearLayout
            android:id="@+id/llActions"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:gravity="center"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnReconnect"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:paddingStart="22dp"
                android:paddingEnd="22dp"
                android:text="Coba Lagi"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold"
                app:backgroundTint="#1e293b"
                app:cornerRadius="12dp"
                style="@style/Widget.MaterialComponents.Button" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnServerSettings"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:layout_marginStart="10dp"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:text="Server"
                android:textAllCaps="false"
                android:textColor="#DD1e293b"
                android:textSize="13sp"
                android:textStyle="bold"
                app:backgroundTint="#E8FFFFFF"
                app:strokeColor="#50000000"
                app:strokeWidth="1dp"
                app:cornerRadius="12dp"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton" />
        </LinearLayout>

        <!-- Footer IP — sedikit di bawah tombol -->
        <TextView
            android:id="@+id/tvServerInfo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="?android:attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:text="192.168.1.28:50051"
            android:textColor="#88334155"
            android:textSize="11sp"
            android:fontFamily="monospace" />

    </LinearLayout>

    <!-- Dim scrim -->
    <View
        android:id="@+id/vPanelDim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#44000000"
        android:visibility="gone" />

    <!-- Right-slide panel — glass white, full height -->
    <LinearLayout
        android:id="@+id/llRightPanel"
        android:layout_width="300dp"
        android:layout_height="match_parent"
        android:layout_gravity="end"
        android:background="@drawable/bg_glass_panel"
        android:elevation="32dp"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="20dp"
        android:paddingBottom="20dp"
        android:translationX="320dp">

        <!-- Panel header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_marginBottom="4dp">

            <ImageButton
                android:id="@+id/btnPanelBack"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@drawable/bg_btn_glass_icon"
                android:src="@drawable/ic_arrow_back"
                android:contentDescription="Tutup"
                android:padding="7dp"
                android:layout_marginEnd="12dp"
                android:tint="#CC1e293b" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Pengaturan Server"
                    android:textColor="#E61e293b"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Host dan port gRPC"
                    android:textColor="#88334155"
                    android:textSize="11sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="0.8dp"
            android:background="#28000000"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="16dp" />

        <!-- Scrollable fields -->
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:scrollbars="none"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- Host label -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Host / IP"
                    android:textColor="#CC0284c7"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.04" />

                <EditText
                    android:id="@+id/etServerHost"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="5dp"
                    android:background="@drawable/bg_input_field"
                    android:hint="10.20.30.64"
                    android:textColorHint="#88334155"
                    android:textColor="#E61e293b"
                    android:textSize="14sp"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:inputType="textUri"
                    android:singleLine="true" />

                <!-- Port label -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="Port"
                    android:textColor="#CC0284c7"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.04" />

                <EditText
                    android:id="@+id/etGrpcPort"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="5dp"
                    android:background="@drawable/bg_input_field"
                    android:hint="50051"
                    android:textColorHint="#88334155"
                    android:textColor="#E61e293b"
                    android:textSize="14sp"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:inputType="number"
                    android:singleLine="true" />

                <!-- Preview -->
                <TextView
                    android:id="@+id/tvResolvedPreview"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:background="@drawable/bg_input_field"
                    android:padding="11dp"
                    android:textColor="#CC0284c7"
                    android:textSize="12sp"
                    android:fontFamily="monospace"
                    android:text="10.20.30.64:50051" />

            </LinearLayout>
        </ScrollView>

        <!-- Save button -->
        <Button
            android:id="@+id/btnSave"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_btn_primary"
            app:backgroundTint="@null"
            android:text="Simpan"
            android:textAllCaps="false"
            android:textColor="#ffffff"
            android:textSize="14sp"
            android:textStyle="bold" />

        <!-- Reset / Batal row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnResetDefault"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_btn_glass_secondary"
                app:backgroundTint="@null"
                android:text="Reset"
                android:textAllCaps="false"
                android:textColor="#CC1e293b"
                android:textSize="12sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnCancel"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_btn_glass_secondary"
                app:backgroundTint="@null"
                android:text="Batal"
                android:textAllCaps="false"
                android:textColor="#CC1e293b"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

    </LinearLayout>

</FrameLayout>

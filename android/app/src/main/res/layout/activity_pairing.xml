<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Aurora base (putih lavender) -->
    <View
        android:id="@+id/vAuroraBg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#FFF0EEFF" />

    <!-- Aurora blob view — added programmatically -->
    <FrameLayout
        android:id="@+id/flAuroraContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Main content: floating, centered, no card, no scroll -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingStart="32dp"
        android:paddingEnd="32dp">

        <!-- App name -->
        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="HNDSigma"
            android:textColor="#CC1e293b"
            android:textSize="32sp"
            android:textStyle="bold"
            android:letterSpacing="-0.02"
            app:layout_constraintBottom_toTopOf="@id/tvSubtitle"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_chainStyle="packed"
            app:layout_constraintVertical_bias="0.38" />

        <!-- Short subtitle -->
        <TextView
            android:id="@+id/tvSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Digital Signage Player"
            android:textColor="#8A334155"
            android:textSize="13sp"
            app:layout_constraintBottom_toTopOf="@id/llStatusPill"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Glass Status Pill -->
        <LinearLayout
            android:id="@+id/llStatusPill"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_status_pill_offline"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="14dp"
            android:paddingEnd="16dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            app:layout_constraintBottom_toTopOf="@id/tvPairingCode"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <View
                android:id="@+id/vStatusLed"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:layout_marginEnd="7dp"
                android:background="@drawable/led_dot_offline" />

            <TextView
                android:id="@+id/tvStatusCode"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.06"
                android:text="OFFLINE"
                android:textColor="@color/status_offline_text"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Pairing Code — glass badge, hidden by default -->
        <TextView
            android:id="@+id/tvPairingCode"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_pairing_code_display"
            android:fontFamily="monospace"
            android:letterSpacing="0.14"
            android:paddingStart="28dp"
            android:paddingEnd="28dp"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            android:text="---"
            android:textColor="#DD1e293b"
            android:textSize="28sp"
            android:textStyle="bold"
            android:visibility="gone"
            app:layout_constraintBottom_toTopOf="@id/pbConnecting"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Spinner -->
        <ProgressBar
            android:id="@+id/pbConnecting"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:layout_marginTop="10dp"
            android:indeterminate="true"
            android:visibility="gone"
            app:layout_constraintBottom_toTopOf="@id/tvStatusMessage"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Status message — 1 line max -->
        <TextView
            android:id="@+id/tvStatusMessage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:maxLines="2"
            android:text="Tidak dapat terhubung."
            android:textColor="#99334155"
            android:textSize="12sp"
            app:layout_constraintBottom_toTopOf="@id/llActions"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Action Buttons -->
        <LinearLayout
            android:id="@+id/llActions"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:gravity="center"
            android:orientation="horizontal"
            app:layout_constraintBottom_toTopOf="@id/tvServerInfo"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <Button
                android:id="@+id/btnReconnect"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:background="@drawable/bg_btn_reconnect"
                app:backgroundTint="@null"
                android:paddingStart="22dp"
                android:paddingEnd="22dp"
                android:text="Coba Lagi"
                android:textAllCaps="false"
                android:textColor="@color/btn_reconnect_text"
                android:textSize="13sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnServerSettings"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:layout_marginStart="10dp"
                android:background="@drawable/bg_btn_server_outline"
                app:backgroundTint="@null"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:text="Server"
                android:textAllCaps="false"
                android:textColor="@color/btn_server_text"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- Footer: server info -->
        <TextView
            android:id="@+id/tvServerInfo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:background="?android:attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:text="192.168.1.28:50051"
            android:textColor="#66334155"
            android:textSize="11sp"
            android:fontFamily="monospace"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Dim overlay -->
    <View
        android:id="@+id/vPanelDim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#44000000"
        android:visibility="gone" />

    <!-- Right-slide Settings Panel — white glass -->
    <LinearLayout
        android:id="@+id/llRightPanel"
        android:layout_width="320dp"
        android:layout_height="match_parent"
        android:layout_gravity="end"
        android:background="@drawable/bg_glass_panel"
        android:elevation="24dp"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="20dp"
        android:paddingBottom="20dp"
        android:translationX="360dp">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_marginBottom="12dp">

            <ImageButton
                android:id="@+id/btnPanelBack"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@drawable/bg_btn_server_outline"
                android:src="@drawable/ic_arrow_back"
                android:contentDescription="Tutup"
                android:padding="7dp"
                android:layout_marginEnd="12dp"
                android:tint="@color/sheet_text_primary" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Server"
                android:textColor="@color/sheet_text_primary"
                android:textSize="18sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/sheet_card_border"
            android:layout_marginBottom="16dp" />

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:scrollbars="none"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Host / IP"
                    android:textColor="@color/primary_500"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.04" />

                <EditText
                    android:id="@+id/etServerHost"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="4dp"
                    android:background="@drawable/bg_input_field"
                    android:hint="10.20.30.64"
                    android:textColorHint="@color/sheet_text_muted"
                    android:textColor="@color/sheet_text_primary"
                    android:textSize="14sp"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:inputType="textUri"
                    android:singleLine="true" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="Port"
                    android:textColor="@color/primary_500"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.04" />

                <EditText
                    android:id="@+id/etGrpcPort"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="4dp"
                    android:background="@drawable/bg_input_field"
                    android:hint="50051"
                    android:textColorHint="@color/sheet_text_muted"
                    android:textColor="@color/sheet_text_primary"
                    android:textSize="14sp"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:inputType="number"
                    android:singleLine="true" />

                <TextView
                    android:id="@+id/tvResolvedPreview"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:background="@drawable/bg_input_field"
                    android:padding="11dp"
                    android:textColor="@color/primary_500"
                    android:textSize="12sp"
                    android:fontFamily="monospace"
                    android:text="10.20.30.64:50051" />

            </LinearLayout>
        </ScrollView>

        <!-- Buttons -->
        <Button
            android:id="@+id/btnSave"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_btn_primary"
            app:backgroundTint="@null"
            android:text="Simpan"
            android:textAllCaps="false"
            android:textColor="#ffffff"
            android:textSize="14sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnResetDefault"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_btn_secondary"
                app:backgroundTint="@null"
                android:text="Reset"
                android:textAllCaps="false"
                android:textColor="@color/sheet_btn_secondary_text"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btnCancel"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_btn_secondary"
                app:backgroundTint="@null"
                android:text="Batal"
                android:textAllCaps="false"
                android:textColor="@color/sheet_btn_secondary_text"
                android:textSize="12sp" />
        </LinearLayout>

    </LinearLayout>

</FrameLayout>

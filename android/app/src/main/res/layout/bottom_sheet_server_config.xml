<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_bottom_sheet"
    android:paddingStart="28dp"
    android:paddingEnd="28dp"
    android:paddingTop="12dp"
    android:paddingBottom="24dp">

    <!-- Drag Handle -->
    <View
        android:layout_width="48dp"
        android:layout_height="5dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="16dp"
        android:background="#cbd5e1" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Title & Subtitle -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="⚙️ Konfigurasi Endpoint Server"
                android:textColor="#0f172a"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="20dp"
                android:text="Atur Host &amp; Port server tanpa perlu compile ulang APK. Perubahan langsung aktif saat disimpan."
                android:textColor="#64748b"
                android:textSize="13sp" />

            <!-- Server Host / IP -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="ALAMAT HOST / IP SERVER"
                android:textColor="#0284c7"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.05" />

            <EditText
                android:id="@+id/etServerHost"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_input_field"
                android:hint="contoh: 192.168.1.46 atau signage.local"
                android:textColorHint="#94a3b8"
                android:textColor="#0f172a"
                android:textSize="15sp"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:inputType="textUri"
                android:singleLine="true" />

            <!-- Ports Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="horizontal"
                android:baselineAligned="false">

                <!-- HTTP Port -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="8dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="PORT HTTP / API"
                        android:textColor="#0284c7"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.05" />

                    <EditText
                        android:id="@+id/etHttpPort"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="6dp"
                        android:background="@drawable/bg_input_field"
                        android:hint="80"
                        android:textColorHint="#94a3b8"
                        android:textColor="#0f172a"
                        android:textSize="15sp"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp"
                        android:inputType="number"
                        android:singleLine="true" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Port web &amp; register (default: 80)"
                        android:textColor="#64748b"
                        android:textSize="11sp" />
                </LinearLayout>

                <!-- gRPC Port -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="PORT gRPC (STREAM)"
                        android:textColor="#0284c7"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.05" />

                    <EditText
                        android:id="@+id/etGrpcPort"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="6dp"
                        android:background="@drawable/bg_input_field"
                        android:hint="50051"
                        android:textColorHint="#94a3b8"
                        android:textColor="#0f172a"
                        android:textSize="15sp"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp"
                        android:inputType="number"
                        android:singleLine="true" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Port backend tonic (default: 50051)"
                        android:textColor="#64748b"
                        android:textSize="11sp" />
                </LinearLayout>

            </LinearLayout>

            <!-- Resolved Preview Info -->
            <TextView
                android:id="@+id/tvResolvedPreview"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="#f1f5f9"
                android:padding="12dp"
                android:textColor="#0369a1"
                android:textSize="12sp"
                android:fontFamily="monospace"
                android:text="Target: http://192.168.1.46:80 | gRPC :50051" />

            <!-- Action Buttons Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:orientation="horizontal"
                android:gravity="end">

                <Button
                    android:id="@+id/btnResetDefault"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:background="@drawable/bg_btn_secondary"
                    android:text="Reset Default"
                    android:textAllCaps="false"
                    android:textColor="#475569"
                    android:textSize="13sp"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:layout_marginEnd="10dp" />

                <Button
                    android:id="@+id/btnCancel"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:background="@drawable/bg_btn_secondary"
                    android:text="Batal"
                    android:textAllCaps="false"
                    android:textColor="#334155"
                    android:textSize="13sp"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:layout_marginEnd="10dp" />

                <Button
                    android:id="@+id/btnSave"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:background="@drawable/bg_btn_primary"
                    android:text="Simpan &amp; Hubungkan"
                    android:textAllCaps="false"
                    android:textColor="#ffffff"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp" />

            </LinearLayout>

        </LinearLayout>
    </ScrollView>

</LinearLayout>

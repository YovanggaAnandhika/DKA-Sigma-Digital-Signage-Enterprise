<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme (DayNight adaptive) -->
    <style name="Theme.HNDSigmaPlayer" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/primary_500</item>
        <item name="colorPrimaryVariant">@color/primary_600</item>
        <item name="colorOnPrimary">#ffffff</item>
        <item name="android:statusBarColor">@color/sheet_bg</item>
        <item name="android:navigationBarColor">@color/sheet_bg</item>
    </style>

    <!-- Fullscreen kiosk signage theme -->
    <style name="Theme.HNDSigmaPlayer.Fullscreen" parent="Theme.HNDSigmaPlayer">
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowActionBar">false</item>
        <item name="android:windowBackground">#000000</item>
    </style>

    <!-- Pairing screen theme — always Light regardless of system dark mode -->
    <style name="Theme.HNDSigmaPlayer.Light" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="colorPrimary">@color/primary_500</item>
        <item name="colorOnPrimary">#ffffff</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowActionBar">false</item>
        <item name="android:windowBackground">#FFF5F3FF</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
</resources>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme -->
    <style name="Theme.DKASigmaPlayer" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="colorPrimary">#0284c7</item>
        <item name="colorPrimaryVariant">#0369a1</item>
        <item name="colorOnPrimary">#ffffff</item>
        <item name="android:statusBarColor">#0f172a</item>
        <item name="android:navigationBarColor">#0f172a</item>
    </style>

    <!-- Fullscreen kiosk signage theme -->
    <style name="Theme.DKASigmaPlayer.Fullscreen" parent="Theme.DKASigmaPlayer">
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowActionBar">false</item>
        <item name="android:windowBackground">#000000</item>
    </style>

    <!-- Light theme for pairing -->
    <style name="Theme.DKASigmaPlayer.Light" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="colorPrimary">#1c1917</item>
        <item name="colorOnPrimary">#ffffff</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowActionBar">false</item>
        <item name="android:windowBackground">#f7f5f0</item>
        <item name="android:statusBarColor">#f7f5f0</item>
        <item name="android:navigationBarColor">#f7f5f0</item>
    </style>
</resources>
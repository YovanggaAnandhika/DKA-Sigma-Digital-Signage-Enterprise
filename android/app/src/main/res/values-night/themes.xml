<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme (Night) -->
    <style name="Theme.DKASigmaPlayer" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">#0284c7</item>
        <item name="colorPrimaryVariant">#0369a1</item>
        <item name="colorOnPrimary">#ffffff</item>
        <item name="android:statusBarColor">#000000</item>
        <item name="android:navigationBarColor">#000000</item>
    </style>

    <!-- Fullscreen kiosk signage theme (Night) -->
    <style name="Theme.DKASigmaPlayer.Fullscreen" parent="Theme.DKASigmaPlayer">
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowActionBar">false</item>
        <item name="android:windowBackground">#000000</item>
    </style>

    <!-- Light theme for pairing (Explicit Light) -->
    <style name="Theme.DKASigmaPlayer.Light" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="colorPrimary">#0284c7</item>
        <item name="colorOnPrimary">#ffffff</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowActionBar">false</item>
        <item name="android:windowBackground">#f8fafc</item>
        <item name="android:statusBarColor">#f8fafc</item>
        <item name="android:navigationBarColor">#f8fafc</item>
    </style>
</resources>
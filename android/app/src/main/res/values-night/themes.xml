<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme (Night) -->
    <style name="Theme.DKASigmaPlayer" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/primary_500</item>
        <item name="colorPrimaryVariant">@color/primary_600</item>
        <item name="colorOnPrimary">#ffffff</item>
        <item name="android:statusBarColor">#000000</item>
        <item name="android:navigationBarColor">#000000</item>
    </style>

    <!-- Fullscreen kiosk signage theme (Night) -->
    <style name="Theme.DKASigmaPlayer.Fullscreen" parent="Theme.DKASigmaPlayer">
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowActionBar">false</item>
        <item name="android:windowBackground">#000000</item>
    </style>

    <!-- Pairing screen theme (Night) -->
    <style name="Theme.DKASigmaPlayer.Light" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/primary_500</item>
        <item name="colorOnPrimary">#ffffff</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowActionBar">false</item>
        <item name="android:windowBackground">@color/screen_bg</item>
        <item name="android:statusBarColor">@color/screen_bg</item>
        <item name="android:navigationBarColor">@color/screen_bg</item>
    </style>
</resources>